"""Highlight configuration and presets for motorcycle video analysis."""

from dataclasses import dataclass, field


@dataclass(frozen=True)
class HighlightPreset:
    """A predefined highlight preset with description and AI prompt."""

    name: str
    description: str
    ai_prompt: str
    min_score: float = 7.0
    max_duration_minutes: float | None = None


