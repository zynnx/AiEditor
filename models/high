@dataclass(slots=True, frozen=True)
class Highlight:
    """A highlight generated from analysis results."""

    preset_name: str
    clip_count: int
    total_duration: float
    average_score: float
    peak_score: float


def get_preset(name: str) -> HighlightPreset | None:
    """Retrieve a preset by name (case-insensitive)."""
    for preset in PRESETS:
        if preset.name.lower() == name.lower():
            return preset
    return None


def list_presets() -> tuple[HighlightPreset, ...]:
    """Return all available presets."""
    return PRESETS